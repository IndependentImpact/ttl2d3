@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://independentimpact.org/ns/concepts#> .

ex:WorkflowStepScheme a skos:ConceptScheme ;
  skos:prefLabel "Workflow step scheme" ;
  skos:hasTopConcept
    ex:WorkflowStepProjectDeveloperPLA,
    ex:WorkflowStepProjectDeveloperPRR,
    ex:WorkflowStepProjectDeveloperVicIR,
    ex:WorkflowStepProjectDeveloperDLR,
    ex:WorkflowStepProjectDeveloperMR,
    ex:WorkflowStepProjDevPDDxA,
    ex:WorkflowStepProjDevPDDxB,
    ex:WorkflowStepProjDevPDDxC,
    ex:WorkflowStepProjDevCIR,
    ex:WorkflowStepAgentAD,
    ex:WorkflowStepAgentLA,
    ex:WorkflowStepStandardBodyDRPRR,
    ex:WorkflowStepStandardBodyDRPLA,
    ex:WorkflowStepStandardBodyDRVicIR,
    ex:WorkflowStepValidatorDRCIR,
    ex:WorkflowStepVerifierDRMR,
    ex:WorkflowStepVerifierDRDLR,
    ex:WorkflowStepValidatorDRPDDxA,
    ex:WorkflowStepValidatorDRPDDxB,
    ex:WorkflowStepValidatorDRPDDxC .

ex:DocumentTypeScheme a skos:ConceptScheme ;
  skos:prefLabel "Document type scheme" ;
  skos:hasTopConcept
    ex:DocTypeDRPRR,
    ex:DocTypePRR,
    ex:DocTypeDRPLA,
    ex:DocTypePLA,
    ex:DocTypeDRCIR,
    ex:DocTypeCIR,
    ex:DocTypeDRMR,
    ex:DocTypeMR,
    ex:DocTypeDRDLR,
    ex:DocTypeDLR,
    ex:DocTypeDRPDDxA,
    ex:DocTypeDRPDDxB,
    ex:DocTypeDRPDDxC,
    ex:DocTypePDDxA,
    ex:DocTypePDDxB,
    ex:DocTypePDDxC,
    ex:DocTypeLA,
    ex:DocTypeDRLA,
    ex:DocTypeDRVicIR,
    ex:DocTypeVicIR,
    ex:DocTypeGenericDocumentReview,
    ex:DocTypeDataset .

ex:DocumentStatusScheme a skos:ConceptScheme ;
  skos:prefLabel "Document status scheme" ;
  skos:hasTopConcept
    ex:DocStatusDraft,
    ex:DocStatusPublished,
    ex:DocStatusSubmitted .

ex:DocumentStatus2Scheme a skos:ConceptScheme ;
  skos:prefLabel "Document status2 scheme" ;
  skos:scopeNote "UI-derived status labels (option.status2) used in Guardian workflows." ;
  skos:hasTopConcept
    ex:DocStatus2Draft,
    ex:DocStatus2Submitted,
    ex:DocStatus2Published,
    ex:DocStatus2Issued,
    ex:DocStatus2Reviewed,
    ex:DocStatus2Revoked .

ex:DocumentOutcomeScheme a skos:ConceptScheme ;
  skos:prefLabel "Document outcome scheme" ;
  skos:hasTopConcept
    ex:DocOutcomePending,
    ex:DocOutcomeApproved,
    ex:DocOutcomeRejected,
    ex:DocOutcomeCorrectionsRequested,
    ex:DocOutcomeClarificationRequested,
    ex:DocOutcomeReviewed,
    ex:DocOutcomeIssued,
    ex:DocOutcomeRevoked .

ex:WorkflowStepStateScheme a skos:ConceptScheme ;
  skos:prefLabel "Workflow step state scheme" ;
  skos:hasTopConcept
    ex:StepStateStart,
    ex:StepStateInProgress,
    ex:StepStatePendingReview,
    ex:StepStateRetry,
    ex:StepStateDone,
    ex:StepStateCompleted,
    ex:StepStateNotAllowedYet,
    ex:StepStateReadyForRepeat,
    ex:StepStateNotNeeded .

